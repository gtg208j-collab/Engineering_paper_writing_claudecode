% =============================================================================
% references.bib — IEEEtran Bibliography
% Engineering Paper Writing Workflow v1.1.0
%
% FIELD REQUIREMENTS (IEEE):
%   Journal article : author, title, journal, year, volume, number, pages, doi
%   Conference paper: author, title, booktitle, year, pages, doi
%   Book            : author, title, publisher, year, edition (if > 1st)
%   Thesis          : author, title, school, year, type
%   Technical report: author, title, institution, year, number, type
%
% VALIDATION:
%   Run: python scripts/format_references.py --style ieee
%
% IEEEtran formatting rules:
%   - Journal names: use official abbreviation (e.g., "IEEE Trans. Ind. Electron.")
%   - Conference names: use official abbreviation (e.g., "Proc. IEEE CDC")
%   - Author names: Last, F. M. format
%   - Page ranges: use -- (en-dash), e.g., pages = {100--110}
%   - DOI: always include if available
% =============================================================================

% ---- TEMPLATE ENTRIES (replace/extend with your actual references) ----------

@article{Son2024TIM,
  author  = {Son, Hungsun and Author, B.},
  title   = {Insert Your Previous Paper Title},
  journal = {{IEEE} Trans. Instrum. Meas.},
  year    = {2024},
  volume  = {73},
  number  = {1},
  pages   = {1--12},
  doi     = {10.1109/TIM.2024.XXXXXXX}
}

@article{TODO_ref,
  author  = {Lastname, Firstname and Coauthor, Name},
  title   = {Baseline Method Paper Title},
  journal = {{IEEE} Trans. Ind. Electron.},
  year    = {2023},
  volume  = {70},
  number  = {5},
  pages   = {5000--5010},
  doi     = {10.1109/TIE.2023.XXXXXXX}
}

@article{Baseline_PID,
  author  = {Author, A. and Author, B.},
  title   = {PID Control Method Reference},
  journal = {Control Eng. Practice},
  year    = {2022},
  volume  = {120},
  pages   = {105023},
  doi     = {10.1016/j.conengprac.2022.105023}
}

% ---- JOURNAL ABBREVIATIONS REFERENCE --------------------------------------
% Use these official IEEE abbreviations in your .bib file:
%
%   IEEE Transactions on Industrial Electronics
%     → {IEEE} Trans. Ind. Electron.
%
%   IEEE Transactions on Instrumentation and Measurement
%     → {IEEE} Trans. Instrum. Meas.
%
%   IEEE/ASME Transactions on Mechatronics
%     → {IEEE/ASME} Trans. Mechatronics
%
%   IEEE Transactions on Automatic Control
%     → {IEEE} Trans. Autom. Control
%
%   IEEE Transactions on Robotics
%     → {IEEE} Trans. Robot.
%
%   IEEE Robotics and Automation Letters
%     → {IEEE} Robot. Autom. Lett.
%
%   Automatica
%     → Automatica
%
%   Mechatronics (Elsevier)
%     → Mechatronics
%
%   Control Engineering Practice
%     → Control Eng. Practice
%
%   Aerospace Science and Technology
%     → Aerosp. Sci. Technol.
%
% ---- CONFERENCE ABBREVIATIONS REFERENCE -----------------------------------
%   ICRA  → {Proc. IEEE Int. Conf. Robot. Autom. (ICRA)}
%   IROS  → {Proc. IEEE/RSJ Int. Conf. Intell. Robots Syst. (IROS)}
%   CDC   → {Proc. IEEE Conf. Decis. Control (CDC)}
%   ACC   → {Proc. Amer. Control Conf. (ACC)}
%   ECC   → {Proc. Eur. Control Conf. (ECC)}
%   IFAC  → {Proc. IFAC World Congr.}

% ---- EXAMPLE: Conference Paper --------------------------------------------
@inproceedings{Example_Conf,
  author    = {Son, Hungsun and Student, Name},
  title     = {Conference Paper Title},
  booktitle = {Proc. IEEE Int. Conf. Robot. Autom. (ICRA)},
  year      = {2024},
  pages     = {1234--1240},
  doi       = {10.1109/ICRA.2024.XXXXXXX}
}

% ---- EXAMPLE: Book --------------------------------------------------------
@book{Example_Book,
  author    = {Franklin, Gene F. and Powell, J. David and Emami-Naeini, Abbas},
  title     = {Feedback Control of Dynamic Systems},
  publisher = {Pearson},
  year      = {2019},
  edition   = {8th}
}

% ---- EXAMPLE: Technical Report / Standard ----------------------------------
@techreport{Example_TechReport,
  author      = {{International Organization for Standardization}},
  title       = {{ISO} XXXXX: Standard Title},
  institution = {ISO},
  year        = {2023},
  type        = {Standard},
  number      = {ISO/IEC XXXXX}
}

% ---- EXAMPLE: Thesis -------------------------------------------------------
@phdthesis{Example_Thesis,
  author = {Student, Name},
  title  = {Dissertation Title},
  school = {UNIST},
  year   = {2023},
  type   = {{Ph.D.} dissertation}
}
